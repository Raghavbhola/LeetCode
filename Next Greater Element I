class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        stack = []
        mapp ={}
        for num in nums2:
            while stack and stack[-1] < num:
                mapp[stack.pop()] = num
            stack.append(num)
        nxt = [mapp.get(x,-1) for x in nums1]    
        return nxt
