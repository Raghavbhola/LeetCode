class Solution:
    def threeSumClosest(self, nums: list[int], target: int) -> int:
        nums.sort()
        n = len(nums)
        closest = float('inf')
        # for i in range(n):
        #     for j in range(i+1, n):
        #         for k in range(j+1,n):
        #             s = nums[i] + nums[j] + nums[k]
        #             if abs(target - s) < abs(target - closest):
        #                 closest = s   #it will update it best sum
        # return closest     

        for i in range(len(nums) - 2):
            l, r = i+1, len(nums)-1
            while l< r:
                s = nums[i] + nums[l] + nums[r]
                if abs(target - s) < abs(target - closest):
                    closest = s
                if s < target:
                    l += 1
                elif s > target:
                    r -= 1
                else:
                    closest = s 
                    break  
        return closest                 
        
