class Solution:
    def summaryRanges(self, nums: List[int]) -> List[str]:
        # to solve this problem, use consecutive 
        result = [] # empty list to store range
        i = 0       #beginning pointer
        for j in range(len(nums)):
             # if it's the last element or the next is not consecutive.
            if j + 1 == len(nums) or nums[j+1] != nums[j] + 1:
                if nums[i] == nums[j]:
                    result.append(str(nums[i]))
                else:
                    result.append(f"{nums[i]}->{nums[j]}")
                i = j + 1  #reset - new range start from next int.
        return result        
