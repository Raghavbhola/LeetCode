class Solution:
    def threeFibonacciSum(self, n: int) -> bool:
        if n <= 1:
            return False
            
        fib = [1,2]
        while fib[-1] <= n:
            fib.append(fib[-1] + fib[-2])

        if n== 1 or n == 2:
            return True
            
        for i in range(len(fib) - 2):
            if fib[i] + fib[i+1] + fib[i+2] == n:
                return True
                
        return False
        
        
