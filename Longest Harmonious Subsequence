from collections import Counter
class Solution:
    def findLHS(self, nums: list[int]) -> int:
        # res = []
        # for i in range(len(nums)-1):
        #     if abs(nums[i] - nums[i+1]) == 1:
        #         res.append(nums[i])
        #         res.append(nums[i+1])
        #         if i+2 < len(nums) and  nums[i+1] == nums[i+2]:
        #             res.append(nums[i+1])
        # return len(res) 
        count = Counter(nums)
        longest = 0
        for x in count:
            if x+1 in count:  #check consecutive number
                longest = max(longest, count[x]+count[x+1])
        return longest        
        
