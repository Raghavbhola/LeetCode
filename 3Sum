class Solution:
    def threeSum(self, nums: list[int]) -> list[list[int]]:
        nums.sort()
        found = []
        n = len(nums)

        # for i in range(n):
        #     for j in range(i+1, n):
        #         for k in range(j+1, n):
        #             if nums[i] + nums[j] + nums[k] == 0:
        #                 tri = sorted([nums[i] , nums[j], nums[k]])
        #                 if tri not in found:
        #                     found.append(tri)
        # return found   
        for i in range(n-2):
            if i > 0 and nums[i] == nums[i-1]:
                continue  #skip duplicate i
            j,k = i+1, n-1
            while j<k:
                s = (nums[i] + nums[j] + nums[k])
                if s == 0:
                    found.append([nums[i], nums[j], nums[k]])
                    j += 1
                    k -= 1
                    while j < k and nums[j] == nums[j-1]:     #skips duplicates of j
                        j += 1
                    while j < k and nums[k] == nums[k+1]:    #skips of duplicates of k
                        k -= 1    
                elif s< 0:
                    j += 1
                else:
                    k -= 1
        return found                    

