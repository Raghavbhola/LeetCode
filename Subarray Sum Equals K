class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        count = 0
        # sub_array = []

        # for i in range(len(nums)):
        #     for j in range(i, len(nums)):
        #         sub = nums[i:j+1]
        #         sub_array.append(sub)

        #         if sum(sub) == k:
        #             count += 1
        # return count            
    	
        prefix_sum = 0
        freq = {0:1} 
        for num in nums:
            prefix_sum += num
            if (prefix_sum-k) in freq:
                count += freq[prefix_sum - k]
            freq[prefix_sum] = freq.get(prefix_sum,0) + 1
        return count
