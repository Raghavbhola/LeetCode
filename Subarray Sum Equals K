class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        count = 0
        sub_array = []

        for i in range(len(nums)):
            for j in range(i, len(nums)):
                sub = nums[i:j+1]
                sub_array.append(sub)

                if sum(sub) == k:
                    count += 1
        return count            
