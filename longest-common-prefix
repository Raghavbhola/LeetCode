class Solution:
    def longestCommonPrefix(self, strs: List[str]) -> str:
        
        prefix = strs[0]
        for i in range(1, len(strs)):
            word = strs[i]
            while not word.startswith(prefix): #while prefix doesn't match
                prefix = prefix[:-1]           # for shrink the prefix
                if prefix == "":     
                    break  
                else:
                    ""                         # when its an empty, no common prefix
        return prefix                
