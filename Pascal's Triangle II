class Solution:
    def getRow(self, rowIndex: int) -> List[int]:
        triangle = []
        
        n = rowIndex + 1
        for i in range(n):
            row = [1] * (i+1) 
            for j in range(1,i):
                row[j] = triangle[i-1] [j-1] + triangle[i-1][j]
            triangle.append(row)

        return triangle[-1]         #last index to get execution.
        
