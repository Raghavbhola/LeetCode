class Solution:
    def dailyTemperatures(self, temperatures: list[int]) -> list[int]:
        n = len(temperatures)
        stack = []   #store indices (days)
        ans = [0] * n

        for i in range(n-1,-1,-1):  #right to left
            while stack and temperatures[stack[-1]] <= temperatures[i]:
                stack.pop()
            if stack:
                ans[i] = stack[-1] -i
            stack.append(i)    
        return ans    
