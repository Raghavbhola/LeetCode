from collections import Counter
class Solution:
    def majorityElement(self, nums: List[int]) -> List[int]:
        res = []
        # for i in nums:
        #     if i // 3 == 0:
        #         res.append(i)
        # return res        
        n = len(nums)
        freq = Counter(nums)

        for num, count in freq.items():
            if count > n // 3:
                res.append(num)
        return res        
